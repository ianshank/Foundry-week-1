{
  "//": [
    "Copy to mcp/mcp.json and fill in the absolute paths. mcp.json is gitignored:",
    "it will contain real paths and, if you add one, a token.",
    "",
    "Register in Agent Builder via:",
    "  Tool -> + MCP Server -> Connect to an Existing MCP Server -> Command (stdio)",
    "",
    "Expect the Toolkit to fail the first tool-add and open mcp.json for the env",
    "block. That is the documented flow, not a bug -- the server refuses to run",
    "without an allow list, and it is supposed to.",
    "",
    "PLANLINT_ALLOWED_ROOTS is the security boundary. There is no wildcard, and",
    "an unset value means only PLANLINT_TARGET is readable. Widen it deliberately."
  ],
  "servers": {
    "foundry-spike": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/ABSOLUTE/PATH/TO/Foundry-week-1/mcp",
        "foundry-spike-mcp",
        "serve"
      ],
      "env": {
        "PLANLINT_BIN": "planlint",
        "PLANLINT_TARGET": "/ABSOLUTE/PATH/TO/src/Agents",
        "PLANLINT_ALLOWED_ROOTS": "/ABSOLUTE/PATH/TO/src/Agents",
        "PLANLINT_TIMEOUT": "120",
        "PLANLINT_JSON_FLAG": "--json",
        "EVAL_SINK_DIR": "/ABSOLUTE/PATH/TO/src/Agents/.eval-runs",
        "EVAL_ALLOWED_ROOTS": "/ABSOLUTE/PATH/TO/src/Agents/.eval-runs"
      }
    }
  },
  "//alternative": [
    "Without uv, point command at the venv interpreter instead:",
    "  \"command\": \"/ABSOLUTE/PATH/TO/Foundry-week-1/.venv/bin/python\",",
    "  \"args\": [\"-m\", \"foundry_spike_mcp\", \"serve\"]"
  ]
}
