# Copy to .env and fill in. `.env` is gitignored; never commit a filled copy.
#   set -a; source .env; set +a

# ---------------------------------------------------------------- runbook 0.2
# Repo whose OpenSpec specs get linted.
PLANLINT_TARGET="$HOME/src/Agents"
# Eval-harness source repo (for `eval-harness list-plugins` and the demo run).
AGENTS_REPO="$HOME/src/Agents"
# This repo. Evidence, traces and configs land under it.
SPIKE_HOME="$HOME/spikes/foundry-week1"

# ------------------------------------------------------------ tool guard rails
# Absolute paths lint_openspec may read. Colon-separated. Fails closed: when
# unset, only PLANLINT_TARGET is allowed. There is no wildcard.
PLANLINT_ALLOWED_ROOTS="$HOME/src/Agents"
# planlint executable. Override to point at a venv or a stand-in.
PLANLINT_BIN="planlint"
# Seconds before a lint is abandoned. A timeout maps to BLOCKED, never FINDINGS.
PLANLINT_TIMEOUT="120"
# Spelling of planlint's machine-readable output flag. Confirmed in session 1
# against the installed build -- see evidence/00-planlint-flags.txt. Set to the
# empty string to omit it; verdicts stay correct, findings degrade to raw text.
PLANLINT_JSON_FLAG="--json"

# Where eval-harness `json_file` sink artifacts live, and what score_run may read.
EVAL_SINK_DIR="$HOME/src/Agents/.eval-runs"
EVAL_ALLOWED_ROOTS="$HOME/src/Agents/.eval-runs"

# ------------------------------------------------- selfcheck (runbook step 3)
# Three targets that should produce the three verdicts. The BLOCKED one
# defaults to a fresh empty temp dir when unset, so it is optional.
SELFCHECK_PASS_TARGET=""
SELFCHECK_FINDINGS_TARGET=""
SELFCHECK_BLOCKED_TARGET=""

# ------------------------------------------- headless verifier probe (step 2)
# GitHub Models: a fine-grained PAT with the `models:read` permission.
GITHUB_TOKEN=""
GITHUB_MODELS_ENDPOINT="https://models.github.ai/inference"
# Ollama's OpenAI-compatible endpoint. No key needed.
OLLAMA_ENDPOINT="http://localhost:11434/v1"
# Comma-separated `provider:model` slots for the bake-off, e.g.
#   github:openai/gpt-4o-mini,github:meta/Llama-3.3-70B-Instruct,ollama:qwen2.5:14b
PROBE_MODELS=""
