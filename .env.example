# Copy to .env and fill in. `.env` is gitignored; never commit a filled copy.
#   set -a; source .env; set +a

# ---------------------------------------------------------------- runbook 0.2
# Repo whose OpenSpec specs get linted.
PLANLINT_TARGET="$HOME/src/Agents"
# Eval-harness source repo (for `eval-harness list-plugins` and the demo run).
AGENTS_REPO="$HOME/src/Agents"
# This repo. Evidence, traces and configs land under it.
SPIKE_HOME="$HOME/spikes/foundry-week1"

# ------------------------------------------------------------ tool guard rails
# Absolute paths lint_openspec may read. Colon-separated. Fails closed: when
# unset, only PLANLINT_TARGET is allowed. There is no wildcard.
PLANLINT_ALLOWED_ROOTS="$HOME/src/Agents"
# planlint executable. Override to point at a venv or a stand-in.
PLANLINT_BIN="planlint"
# Seconds before a lint is abandoned. A timeout maps to BLOCKED, never FINDINGS.
PLANLINT_TIMEOUT="120"
# Spelling of planlint's machine-readable output flag. Confirmed in session 1
# against the installed build -- see evidence/00-planlint-flags.txt. Set to the
# empty string to omit it; verdicts stay correct, findings degrade to raw text.
PLANLINT_JSON_FLAG="--json"

# Severity words this planlint build understands. Configuration, because it is
# a property of the installed build. Which *verbs* may run is not configurable
# -- that is policy and lives in guards.py.
PLANLINT_FAIL_ON_VALUES="ERROR,WARN,WARNING,INFO"

# Where eval-harness `json_file` sink artifacts live, and what score_run may read.
EVAL_SINK_DIR="$HOME/src/Agents/.eval-runs"
EVAL_ALLOWED_ROOTS="$HOME/src/Agents/.eval-runs"
EVAL_MAX_ARTIFACT_BYTES="8388608"

# Truncation limits on anything bound for a trace or an evidence file.
FOUNDRY_SPIKE_STDERR_LIMIT="2000"
FOUNDRY_SPIKE_STDOUT_LIMIT="20000"

# Ceiling on the planlint stdout that becomes the `findings` payload. Measured
# in UTF-8 bytes on the raw stream before parsing, so an oversized payload is
# never built into an object at all. Past this the evidence is replaced by an
# excerpt bounded by FOUNDRY_SPIKE_STDOUT_LIMIT above and `findings_truncated`
# is set -- the verdict comes from the exit code and is unaffected either way.
FOUNDRY_SPIKE_FINDINGS_MAX_BYTES="262144"
# Depth ceiling for the redaction walk over that payload. Subtrees below it are
# replaced with a marker rather than dropped silently.
FOUNDRY_SPIKE_FINDINGS_MAX_DEPTH="64"

# ------------------------------------------------------------------- logging
# stderr only -- stdout is the JSON-RPC channel and a line there breaks the
# server. WARNING keeps a healthy run silent; DEBUG is for when a tool
# misbehaves inside the Toolkit and there is no other window into it.
FOUNDRY_SPIKE_LOG_LEVEL="WARNING"     # DEBUG | INFO | WARNING | ERROR
FOUNDRY_SPIKE_LOG_FORMAT="text"       # text | json (json when logs go into evidence)

# ------------------------------------------------- selfcheck (runbook step 3)
# Three targets that should produce the three verdicts. The BLOCKED one
# defaults to a fresh empty temp dir when unset, so it is optional.
SELFCHECK_PASS_TARGET=""
SELFCHECK_FINDINGS_TARGET=""
SELFCHECK_BLOCKED_TARGET=""

# ------------------------------------------- headless verifier probe (step 2)
# GitHub Models: a fine-grained PAT with the `models:read` permission.
GITHUB_TOKEN=""
GITHUB_MODELS_ENDPOINT="https://models.github.ai/inference"
# Ollama's OpenAI-compatible endpoint. No key needed.
OLLAMA_ENDPOINT="http://localhost:11434/v1"
# Comma-separated `provider:model` slots for the bake-off, e.g.
#   github:openai/gpt-4o-mini,github:meta/Llama-3.3-70B-Instruct,ollama:qwen2.5:14b
PROBE_MODELS=""

# Sampling. The runbook requires these identical across every cell so the
# comparison is not measuring sampling noise -- which makes them evidence, and
# every run records the values it used into its summary.json.
PROBE_TEMPERATURE="0"
PROBE_TOP_P="1"
PROBE_MAX_TOKENS="800"
PROBE_TIMEOUT="180"

# Any other OpenAI-shaped endpoint (Foundry Local, LM Studio, vLLM) as slot D.
OPENAI_COMPATIBLE_ENDPOINT=""
OPENAI_COMPATIBLE_KEY=""
